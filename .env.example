# ===========================================
# ConcordVest Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Supabase Configuration (Required)
# Get these from your Supabase project settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_HQROudHvVq-0RVPiTou1pw_w1xLq3AA

# WhatsApp Business Number (Optional - for lead contact)
# Format: country code + number, no spaces or special characters
# Example: 2348156648952
VITE_CONCORDVEST_WHATSAPP_NUMBER=

# Analytics (Optional - Umami Analytics)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# OAuth Portal (Optional - if using external auth)
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# Server Configuration
PORT=3000
NODE_ENV=development
